[0.0097, "o", "\u001b[Hfor i in $(seq 1 5); do printf \"\\033[3%dmcolor %d\\033[0m\\n\" $((i%7+1)) $i;\r\n sleep 0.6; done\r\nmilindsoni@Milinds-MacBook-Pro ~ % for i in $(seq 1 5); do printf \"\\033[3%\r\ndmcolor %d\\033[0m\\n\" $((i%7+1)) $i; sleep 0.6; done\r\n\u001b[0m\u001b[38;5;2mcolor 1\u001b[0m\r\n\u001b[0m\u001b[38;5;3mcolor 2\u001b[0m\r\n\u001b[0m\u001b[38;5;4mcolor 3\u001b[0m\r\n\u001b[0m\u001b[38;5;5mcolor 4\u001b[0m\r\n\u001b[0m\u001b[38;5;6mcolor 5\u001b[0m\r\nmilindsoni@Milinds-MacBook-Pro ~ % printf \"\\033[31mred\\033[0m and \\033[1;3\r\n4mbold blue\\033[0m\\n\"\r\n\u001b[0m\u001b[38;5;1mred\u001b[0m and \u001b[0m\u001b[1m\u001b[38;5;4mbold blue\u001b[0m\r\nmilindsoni@Milinds-MacBook-Pro ~ % for i in $(seq 1 6); do printf \"\\033[1;\r\n35m[right]\\033[0m building %d...\\n\" $i; sleep 0.9; done; printf \"\\033[7m R\r\nEVERSED BANNER \\033[0m\\n\"\r\n\u001b[0m\u001b[1m\u001b[38;5;5m[right]\u001b[0m building 1...\r\n\u001b[0m\u001b[1m\u001b[38;5;5m[right]\u001b[0m building 2...\r\n\u001b[0m\u001b[1m\u001b[38;5;5m[right]\u001b[0m building 3...\r\n\u001b[0m\u001b[1m\u001b[38;5;5m[right]\u001b[0m building 4...\r\n\u001b[0m\u001b[1m\u001b[38;5;5m[right]\u001b[0m building 5...\r\n\u001b[0m\u001b[1m\u001b[38;5;5m[right]\u001b[0m building 6...\r\n\u001b[0m\u001b[7m REVERSED BANNER \u001b[0m\r\nmilindsoni@Milinds-MacBook-Pro ~ % \u001b[0m\u001b[J"]
